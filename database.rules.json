{
  "rules": {
    ".read": false,
    ".write": false,
    "settings": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren()",
      "className": {
        ".validate": "newData.isString() && newData.val().length <= 60"
      },
      "delegateName": {
        ".validate": "newData.isString() && newData.val().length <= 60"
      },
      "delegateLinkToken": {
        ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 64"
      },
      "passwordHash": {
        ".validate": "newData.isString() && newData.val().length <= 200"
      },
      "accentColor": {
        ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{3,8}$/)"
      },
      "homeInfo": {
        ".validate": "newData.isString() && newData.val().length <= 5000"
      },
      "homeImage": {
        ".validate": "newData.isString() && newData.val().length <= 1500000"
      },
      "seasonTheme": {
        ".validate": "newData.val() === 'aucun' || newData.val() === 'halloween' || newData.val() === 'noel'"
      },
      "maintenanceMode": {
        ".validate": "newData.isBoolean()"
      },
      "maintenanceMessage": {
        ".validate": "newData.isString() && newData.val().length <= 500"
      },
      "maintenanceBy": {
        ".validate": "newData.isString() && newData.val().length <= 60"
      },
      "maintenanceAt": {
        ".validate": "newData.isNumber()"
      },
      "createdAt": {
        ".validate": "newData.isNumber()"
      },
      "updatedAt": {
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    },
    "announcements": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$annId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['title', 'description', 'createdAt']))",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "importance": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "attachmentUrl": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "image": {
          ".validate": "newData.isString() && (newData.val().beginsWith('data:image/') || newData.val().beginsWith('https://')) && newData.val().length <= 1500000"
        },
        "published": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $annId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "announcementReactions": {
      ".read": true,
      "$annId": {
        ".write": "!newData.exists()",
        "$reaction": {
          ".validate": "$reaction === 'vu' || $reaction === 'jaime' || $reaction === 'question' || $reaction === 'important'",
          "$fp": {
            ".write": true,
            ".validate": "$fp.length <= 64 && newData.val() === true && newData.parent().parent().parent().parent().child('announcements/' + $annId).exists()"
          }
        }
      }
    },
    "ideas": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "status"
      ],
      "$ideaId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['title', 'status', 'createdAt']))",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "anonymous": {
          ".validate": "newData.isBoolean()"
        },
        "fingerprint": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(a_etudier|en_discussion|transmise|realisee|non_retenue)$/)"
        },
        "delegateResponse": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "delegateRepliedAt": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $ideaId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ideaReplies": {
      ".read": true,
      "$ideaId": {
        ".write": "!newData.exists()",
        "$replyId": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.hasChildren(['content','authorName','createdAt']) && newData.parent().parent().parent().child('ideas/' + $ideaId).exists())",
          "content": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
          },
          "authorName": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "fingerprint": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "messages": {
      ".read": true,
      ".indexOn": [
        "fingerprint",
        "createdAt"
      ],
      "$msgId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['content', 'createdAt']))",
        "content": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "anonymous": {
          ".validate": "newData.isBoolean()"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "fingerprint": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "delegateReply": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "repliedAt": {
          ".validate": "newData.isNumber()"
        },
        "responseReadAt": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $msgId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "polls": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$pollId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['question', 'options', 'createdAt']))",
        "question": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "allowMultiple": {
          ".validate": "newData.isBoolean()"
        },
        "showResults": {
          ".validate": "newData.isBoolean()"
        },
        "anonymous": {
          ".validate": "newData.isBoolean()"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "closedAt": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "options": {
          "$optId": {
            ".validate": "$optId.matches(/^o[0-9]{1,2}$/) && newData.hasChildren(['text'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "position": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $pollId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pollVotes": {
      ".read": true,
      "$pollId": {
        ".write": "!newData.exists() && !newData.parent().parent().child('polls/' + $pollId).exists()",
        "$fp": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "$fp.length <= 64 && newData.hasChildren(['options','createdAt']) && newData.parent().parent().parent().child('polls/' + $pollId).exists() && newData.parent().parent().parent().child('polls/' + $pollId + '/active').val() !== false",
          "options": {
            "$optId": {
              ".validate": "newData.val() === true && newData.parent().parent().parent().parent().parent().child('polls/' + $pollId + '/options/' + $optId).exists()"
            }
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "events": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "date"
      ],
      "$eventId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['title', 'date']))",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "time": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $eventId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "revisions": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "date"
      ],
      "$revId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['title', 'date']))",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "time": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "duration": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "createdByFingerprint": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $revId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "resources": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$resId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['title', 'createdAt']))",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "fileUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "linkUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $resId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "projects": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$projectId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['name', 'createdAt']))",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "imageUrl": {
          ".validate": "newData.isString() && newData.val().length <= 1500000"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $projectId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sheets": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "status"
      ],
      "$sheetId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['title', 'createdAt']))",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "classLevel": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "authorFingerprint": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "fileName": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "mimeType": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "fileSize": {
          ".validate": "newData.isNumber()"
        },
        "hasFile": {
          ".validate": "newData.isBoolean()"
        },
        "kind": {
          ".validate": "newData.val() === 'image' || newData.val() === 'document'"
        },
        "status": {
          ".validate": "newData.val() === 'active' || newData.val() === 'hidden'"
        },
        "fileData": {
          ".validate": "newData.isString() && newData.val().length <= 600000"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $sheetId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sheetFiles": {
      ".read": true,
      "$sheetId": {
        ".write": true,
        ".validate": "newData.hasChildren(['data']) && newData.parent().parent().child('sheets/' + $sheetId).exists()",
        "data": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:') && newData.val().length <= 6000000"
        },
        "mimeType": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "students": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "lastName"
      ],
      "$studentId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['firstName', 'lastName']))",
        "firstName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "lastName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "birthday": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[0-9]{2}$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $studentId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "birthdays": {
      ".read": true,
      "$fp": {
        ".write": true,
        ".validate": "$fp.length <= 64 && newData.hasChildren(['dateMmdd','firstName'])",
        "dateMmdd": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[0-9]{2}$/)"
        },
        "firstName": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "studentGroups": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$groupId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['name']))",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "isPrivate": {
          ".validate": "newData.isBoolean()"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(en_attente|valide|refuse)$/)"
        },
        "createdByFingerprint": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "validatedAt": {
          ".validate": "newData.isNumber()"
        },
        "validatedBy": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "members": {
          "$memberId": {
            ".validate": "newData.hasChildren(['memberName','memberKey'])",
            "studentId": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "memberName": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "memberKey": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "addedByFingerprint": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "addedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "id": {
          ".validate": "newData.isString() && newData.val() === $groupId"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "groupChats": {
      ".read": true,
      "$groupId": {
        ".write": true,
        ".validate": "!newData.exists() || newData.parent().parent().child('studentGroups/' + $groupId).exists()",
        "closed": {
          ".validate": "newData.isBoolean()"
        },
        "lastActivityAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "groupChatMessages": {
      ".read": true,
      "$groupId": {
        ".write": "!newData.exists()",
        "$msgId": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.hasChildren(['senderId','senderName','createdAt']) && ((newData.child('content').isString() && newData.child('content').val().length > 0) || newData.child('hasImage').val() === true || newData.hasChild('image')) && newData.parent().parent().parent().child('studentGroups/' + $groupId + '/status').val() === 'valide' && (newData.parent().parent().parent().child('groupChats/' + $groupId + '/closed').val() !== true || newData.child('senderKind').val() === 'delegate'))",
          "senderId": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "senderName": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "senderKind": {
            ".validate": "newData.val() === 'student' || newData.val() === 'delegate'"
          },
          "content": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "hasImage": {
            ".validate": "newData.isBoolean()"
          },
          "image": {
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 1500000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 600000"
          },
          "deletedAt": {
            ".validate": "newData.isNumber()"
          },
          "deletedBy": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "groupChatImages": {
      ".read": true,
      "$groupId": {
        ".write": "!newData.exists()",
        "$msgId": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 1500000 && newData.parent().parent().parent().child('groupChatMessages/' + $groupId + '/' + $msgId).exists())"
        }
      }
    },
    "chatUsers": {
      ".read": true,
      "$fp": {
        ".write": true,
        ".validate": "$fp.length <= 64 && newData.hasChildren(['displayName'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "kind": {
          ".validate": "newData.val() === 'student' || newData.val() === 'delegate'"
        },
        "lastSeenAt": {
          ".validate": "newData.isNumber()"
        },
        "lastReadAt": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chatMessages": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$msgId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['senderId','senderName','createdAt']) && ((newData.child('content').isString() && newData.child('content').val().length > 0) || newData.child('hasImage').val() === true || newData.hasChild('image')))",
        "senderId": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "senderName": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "senderKind": {
          ".validate": "newData.val() === 'student' || newData.val() === 'delegate'"
        },
        "content": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "hasImage": {
          ".validate": "newData.isBoolean()"
        },
        "image": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 1500000"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "deletedAt": {
          ".validate": "newData.isNumber()"
        },
        "deletedBy": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chatImages": {
      ".read": true,
      "$msgId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 1500000 && newData.parent().parent().child('chatMessages/' + $msgId).exists())"
      }
    },
    "chatReactions": {
      ".read": true,
      "$msgId": {
        ".write": "!newData.exists()",
        "$reaction": {
          ".validate": "$reaction === 'pouce' || $reaction === 'rire' || $reaction === 'coeur'",
          "$fp": {
            ".write": true,
            ".validate": "$fp.length <= 64 && newData.val() === true"
          }
        }
      }
    },
    "visits": {
      ".read": true,
      "$day": {
        ".write": "!newData.exists()",
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$visitor": {
          ".write": true,
          ".validate": "$visitor.length <= 64 && newData.hasChildren(['hits','lastSeenAt'])",
          "hits": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200"
          },
          "firstSeenAt": {
            ".validate": "newData.isNumber()"
          },
          "lastSeenAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 600000"
          },
          "page": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "maintenanceLog": {
      ".read": true,
      "$logId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['active','at'])",
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "adminLog": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$logId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['action','createdAt'])",
        "action": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "targetType": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "targetId": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "detail": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "meta": {
      ".read": true,
      "migrated": {
        "$path": {
          ".write": "!data.exists()",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}