{
  "rules": {
    ".read": false,
    ".write": false,

    "meta": {
      ".read": true
    },

    "delegates": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid == $uid && (!root.child('delegates').exists() || root.child('delegates').child(auth.uid).exists())",
        ".validate": "newData.val() === true"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".validate": "newData.hasChildren()",
      "className": { ".validate": "newData.isString() && newData.val().length <= 60" },
      "delegateName": { ".validate": "newData.isString() && newData.val().length <= 60" },
      "delegateLinkToken": { ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 64" },
      "passwordHash": { ".validate": "newData.isString() && newData.val().length <= 200" },
      "accentColor": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{3,8}$/)" },
      "homeInfo": { ".validate": "newData.isString() && newData.val().length <= 5000" },
      "homeImage": { ".validate": "newData.isString() && newData.val().length <= 1500000" },
      "seasonTheme": { ".validate": "newData.val() === 'aucun' || newData.val() === 'halloween' || newData.val() === 'noel'" },
      "groupMin": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
      "groupMax": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
      "groupsOpen": { ".validate": "newData.isBoolean()" },
      "maintenanceMode": { ".validate": "newData.isBoolean()" },
      "maintenanceMessage": { ".validate": "newData.isString() && newData.val().length <= 500" },
      "maintenanceBy": { ".validate": "newData.isString() && newData.val().length <= 60" },
      "maintenanceAt": { ".validate": "newData.isNumber()" },
      "createdAt": { ".validate": "newData.isNumber()" },
      "updatedAt": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": false }
    },

    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".indexOn": ["createdAt"],
      "$id": {
        ".validate": "!newData.exists() || newData.hasChildren(['title', 'description', 'createdAt'])",
        "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "importance": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "author": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "attachmentUrl": { ".validate": "newData.isString() && newData.val().matches(/^https?:\\/\\//) && newData.val().length <= 1000" },
        "image": { ".validate": "newData.isString() && (newData.val().beginsWith('data:image/') || newData.val().beginsWith('https://')) && newData.val().length <= 1500000" },
        "published": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "announcementReactions": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$annId": {
        "$reaction": {
          ".validate": "$reaction === 'vu' || $reaction === 'jaime' || $reaction === 'question' || $reaction === 'important'",
          "$fp": { ".validate": "newData.val() === true && $fp.length <= 64" }
        }
      }
    },

    "ideas": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "status"],
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('delegates').child(auth.uid).exists())",
        ".validate": "!newData.exists() || newData.hasChildren(['title', 'status', 'createdAt'])",
        "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "authorName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "anonymous": { ".validate": "newData.isBoolean()" },
        "fingerprint": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "authorUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(a_etudier|en_discussion|transmise|realisee|non_retenue)$/)" },
        "delegateResponse": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "delegateRepliedAt": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "ideaReplies": {
      ".read": "auth != null",
      "$ideaId": {
        "$replyId": {
          ".write": "auth != null && (!data.exists() ? root.child('ideas').child($ideaId).exists() : (root.child('delegates').child(auth.uid).exists() || data.child('authorUid').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['content', 'authorName', 'createdAt']) && newData.child('authorUid').val() === auth.uid)",
          "content": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
          "authorName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "fingerprint": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "authorUid": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "messages": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('delegates').child(auth.uid).exists())",
        ".validate": "!newData.exists() || (newData.hasChildren(['content', 'createdAt']) && (!newData.hasChild('authorUid') || newData.child('authorUid').val() === auth.uid))",
        "content": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "anonymous": { ".validate": "newData.isBoolean()" },
        "authorName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "fingerprint": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "authorUid": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "delegateReply": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "repliedAt": { ".validate": "newData.isNumber()" },
        "responseReadAt": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "polls": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".indexOn": ["createdAt"],
      "$id": {
        ".validate": "!newData.exists() || newData.hasChildren(['question', 'options', 'createdAt'])",
        "question": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "allowMultiple": { ".validate": "newData.isBoolean()" },
        "showResults": { ".validate": "newData.isBoolean()" },
        "anonymous": { ".validate": "newData.isBoolean()" },
        "active": { ".validate": "newData.isBoolean()" },
        "closedAt": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "options": {
          "$optId": {
            ".validate": "$optId.matches(/^o[0-9]{1,2}$/) && newData.hasChildren(['text'])",
            "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "position": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "pollVotes": {
      ".read": "auth != null",
      "$pollId": {
        "$voter": {
          ".write": "auth != null && auth.uid == $voter && !data.exists() && root.child('polls').child($pollId).child('active').val() !== false",
          ".validate": "newData.hasChildren(['options', 'createdAt']) && newData.child('voterUid').val() === auth.uid",
          "options": {
            "$optId": { ".validate": "newData.val() === true && root.child('polls').child($pollId).child('options').child($optId).exists()" }
          },
          "voterUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "events": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".indexOn": ["createdAt", "date"],
      "$id": {
        ".validate": "!newData.exists() || newData.hasChildren(['title', 'date'])",
        "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "time": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "revisions": {
      ".read": "auth != null",
      ".indexOn": ["date"],
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('delegates').child(auth.uid).exists() || data.child('authorUid').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.hasChildren(['title', 'date']) && newData.child('authorUid').val() === auth.uid)",
        "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "subject": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "date": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "time": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "duration": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
        "location": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "createdByFingerprint": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "authorUid": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "resources": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".indexOn": ["createdAt"],
      "$id": {
        ".validate": "!newData.exists() || newData.hasChildren(['title', 'createdAt'])",
        "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "subject": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "fileUrl": { ".validate": "newData.isString() && newData.val().matches(/^https?:\\/\\//) && newData.val().length <= 2000" },
        "linkUrl": { ".validate": "newData.isString() && newData.val().matches(/^https?:\\/\\//) && newData.val().length <= 2000" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "projects": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".indexOn": ["createdAt"],
      "$id": {
        ".validate": "!newData.exists() || newData.hasChildren(['name', 'createdAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "status": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "date": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "imageUrl": { ".validate": "newData.isString() && newData.val().length <= 1500000" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "students": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".indexOn": ["createdAt", "lastName"],
      "$id": {
        ".validate": "!newData.exists() || newData.hasChildren(['firstName', 'lastName'])",
        "firstName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "lastName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "birthday": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[0-9]{2}$/)" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "birthdays": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$fp": {
        ".validate": "newData.hasChildren(['dateMmdd', 'firstName'])",
        "dateMmdd": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[0-9]{2}$/)" },
        "firstName": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "studentGroups": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$groupId": {
        ".write": "auth != null && (root.child('delegates').child(auth.uid).exists() || (root.child('settings/groupsOpen').val() === true && (!data.exists() || data.child('createdByUid').val() === auth.uid || newData.child('createdByUid').val() === auth.uid)))",
        ".validate": "!newData.exists() || newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "isPrivate": { ".validate": "newData.isBoolean()" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(en_attente|valide|refuse)$/) && ((!data.exists() && newData.val() === 'en_attente') || root.child('delegates').child(auth.uid).exists())" },
        "createdByFingerprint": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "createdByUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "validatedAt": { ".validate": "newData.isNumber() && root.child('delegates').child(auth.uid).exists()" },
        "validatedBy": { ".validate": "newData.isString() && newData.val().length <= 60 && root.child('delegates').child(auth.uid).exists()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "members": {
          "$memberId": {
            ".validate": "newData.hasChildren(['memberName', 'memberKey']) && (data.exists() || root.child('delegates').child(auth.uid).exists() || root.child('settings/groupsOpen').val() === true)",
            "studentId": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "memberName": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "memberKey": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "addedByFingerprint": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "addedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "id": { ".validate": "newData.isString() && newData.val() === $groupId" },
        "$other": { ".validate": false }
      }
    },

    "groupChats": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('delegates').child(auth.uid).exists()",
      "$groupId": {
        ".validate": "!newData.exists() || root.child('studentGroups').child($groupId).exists()",
        "closed": { ".validate": "newData.isBoolean()" },
        "lastActivityAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "groupChatMessages": {
      ".read": "auth != null",
      "$groupId": {
        "$msgId": {
          ".write": "auth != null && (!data.exists() ? (root.child('studentGroups').child($groupId).child('status').val() === 'valide' && (root.child('groupChats').child($groupId).child('closed').val() !== true || root.child('delegates').child(auth.uid).exists())) : (root.child('delegates').child(auth.uid).exists() || data.child('senderUid').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['senderId', 'senderName', 'createdAt']) && newData.child('senderUid').val() === auth.uid && ((newData.child('content').isString() && newData.child('content').val().length > 0) || newData.child('hasImage').val() === true))",
          "senderId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "senderUid": { ".validate": "newData.isString()" },
          "senderName": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "senderKind": { ".validate": "newData.val() === 'student' || newData.val() === 'delegate'" },
          "content": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "hasImage": { ".validate": "newData.isBoolean()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "deletedAt": { ".validate": "newData.isNumber()" },
          "deletedBy": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$other": { ".validate": false }
        }
      }
    },

    "groupChatImages": {
      ".read": "auth != null",
      "$groupId": {
        "$msgId": {
          ".write": "auth != null && (!data.exists() ? root.child('groupChatMessages').child($groupId).child($msgId).exists() : (root.child('delegates').child(auth.uid).exists() || data.parent().parent().parent().child('groupChatMessages').child($groupId).child($msgId).child('senderUid').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 1500000)"
        }
      }
    },

    "chatUsers": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$fp": {
        ".validate": "newData.hasChildren(['displayName'])",
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "kind": { ".validate": "newData.val() === 'student' || newData.val() === 'delegate'" },
        "lastSeenAt": { ".validate": "newData.isNumber()" },
        "lastReadAt": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "chatMessages": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$msgId": {
        ".write": "auth != null && (!data.exists() ? true : (root.child('delegates').child(auth.uid).exists() || data.child('senderUid').val() === auth.uid || data.child('createdAt').val() < now - 172800000))",
        ".validate": "!newData.exists() || (newData.hasChildren(['senderId', 'senderName', 'createdAt']) && newData.child('senderUid').val() === auth.uid && ((newData.child('content').isString() && newData.child('content').val().length > 0) || newData.child('hasImage').val() === true))",
        "senderId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "senderUid": { ".validate": "newData.isString()" },
        "senderName": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "senderKind": { ".validate": "newData.val() === 'student' || newData.val() === 'delegate'" },
        "content": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "hasImage": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "deletedAt": { ".validate": "newData.isNumber()" },
        "deletedBy": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "$other": { ".validate": false }
      }
    },

    "chatImages": {
      ".read": "auth != null",
      "$msgId": {
        ".write": "auth != null && (!data.exists() ? root.child('chatMessages').child($msgId).exists() : (root.child('delegates').child(auth.uid).exists() || root.child('chatMessages').child($msgId).child('senderUid').val() === auth.uid || root.child('chatMessages').child($msgId).child('createdAt').val() < now - 172800000))",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 1500000)"
      }
    },

    "chatReactions": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$msgId": {
        "$reaction": {
          ".validate": "$reaction === 'pouce' || $reaction === 'rire' || $reaction === 'coeur'",
          "$fp": { ".validate": "newData.val() === true && $fp.length <= 64" }
        }
      }
    },

    "sheets": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "status"],
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('delegates').child(auth.uid).exists() || data.child('authorUid').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.hasChildren(['title', 'createdAt']) && newData.child('authorUid').val() === auth.uid)",
        "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "subject": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "classLevel": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "authorName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "authorFingerprint": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "authorUid": { ".validate": "newData.isString()" },
        "fileName": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "mimeType": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "fileSize": { ".validate": "newData.isNumber()" },
        "hasFile": { ".validate": "newData.isBoolean()" },
        "kind": { ".validate": "newData.val() === 'image' || newData.val() === 'document'" },
        "status": { ".validate": "newData.val() === 'active' || newData.val() === 'hidden'" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },

    "sheetFiles": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (!data.exists() ? root.child('sheets').child($id).exists() : (root.child('delegates').child(auth.uid).exists() || root.child('sheets').child($id).child('authorUid').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['data']) && newData.child('data').isString() && newData.child('data').val().beginsWith('data:') && newData.child('data').val().length <= 6000000)",
        "data": { ".validate": "newData.isString() && newData.val().beginsWith('data:') && newData.val().length <= 6000000" },
        "mimeType": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "$other": { ".validate": false }
      }
    },

    "messageFiles": {
      ".read": "auth != null && root.child('delegates').child(auth.uid).exists()",
      "$msgId": {
        ".write": "auth != null && (!data.exists() ? (root.child('messages').child($msgId).exists() && (root.child('messages').child($msgId).child('authorUid').val() === auth.uid || root.child('delegates').child(auth.uid).exists())) : root.child('delegates').child(auth.uid).exists())",
        ".validate": "!newData.exists() || (newData.hasChildren(['name', 'type', 'data']) && newData.child('data').val().beginsWith('data:'))",
        "name": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "type": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "size": { ".validate": "newData.isNumber() && newData.val() <= 1048576" },
        "data": { ".validate": "newData.isString() && newData.val().beginsWith('data:') && newData.val().length <= 1450000" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "visits": {
      ".read": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".write": "auth != null",
      "$day": {
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$visitor": {
          ".validate": "newData.hasChildren(['hits', 'lastSeenAt'])",
          "hits": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200" },
          "firstSeenAt": { ".validate": "newData.isNumber()" },
          "lastSeenAt": { ".validate": "newData.isNumber()" },
          "page": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$other": { ".validate": false }
        }
      }
    },

    "maintenanceLog": {
      ".read": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".write": "auth != null && root.child('delegates').child(auth.uid).exists()",
      "$id": {
        ".validate": "newData.hasChildren(['active', 'at'])",
        "active": { ".validate": "newData.isBoolean()" },
        "message": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "by": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "adminLog": {
      ".read": "auth != null && root.child('delegates').child(auth.uid).exists()",
      ".write": "auth != null",
      ".indexOn": ["createdAt"],
      "$id": {
        ".validate": "!data.exists() && newData.hasChildren(['action', 'createdAt'])",
        "action": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "targetType": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "targetId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "detail": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
