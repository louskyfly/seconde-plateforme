{
  "name": "seconde-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plateforme des délégués de classe - Seconde",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsc -p tsconfig.server.json && concurrently -k -n watch,node -c magenta,yellow \"tsc -p tsconfig.server.json --watch --preserveWatchOutput\" \"node --watch dist/server/index.js\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "test": "npm run build && node --test server/tests/api.test.js",
    "load:test": "node scripts/load-test.mjs",
    "load:cleanup": "node scripts/cleanup-load-users.mjs",
    "db:seed": "node dist/server/scripts/seed.js"
  },
  "dependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "concurrently": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "csurf": "^1.11.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.47",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "uuid": "^10.0.0",
    "vite": "^5.4.8",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/csurf": "^1.11.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4"
  }
}
